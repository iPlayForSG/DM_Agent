{
  "description": "DM_Agent 项目记忆的基线观察与增量维护闸门。",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/memory_session.py\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$root = (& git rev-parse --show-toplevel).Trim(); & python (Join-Path $root '.codex/hooks/memory_session.py')\"",
            "timeout": 15,
            "statusMessage": "建立项目记忆基线"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/memory_observe.py\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$root = (& git rev-parse --show-toplevel).Trim(); & python (Join-Path $root '.codex/hooks/memory_observe.py')\"",
            "timeout": 15,
            "statusMessage": "观察项目变化"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/memory_stop.py\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$root = (& git rev-parse --show-toplevel).Trim(); & python (Join-Path $root '.codex/hooks/memory_stop.py')\"",
            "timeout": 20,
            "statusMessage": "检查项目记忆是否需要校准"
          }
        ]
      }
    ]
  }
}
